# Mashkif environment template. Copy to .env next to the Compose file and
# replace every placeholder. Never commit .env.
#
# Docker Compose reads .env twice: for ${...} interpolation in the Compose file
# (only the MASHKIF_* deployment values in the first block) and, through
# env_file, as the environment of the app and db containers.
# Keep comments on their own lines; values have no quotes and no inline comments.

# Deployment values used by Compose interpolation. Paths are absolute; ~ is not
# expanded. For development, MASHKIF_DATA_DIR must be on WSL ext4 (for example
# /home/<user>/mashkif-data), not under /mnt.
# MASHKIF_IMAGE_TAG and MASHKIF_TRAEFIK_NETWORK are used in production only.
MASHKIF_IMAGE_TAG=0.0.0
MASHKIF_DATA_DIR=/absolute/path/to/mashkif-data
MASHKIF_GEOIP_DIR=/absolute/path/to/geoip-directory
MASHKIF_TRAEFIK_NETWORK=traefik-network-name

# PostgreSQL (db container).
POSTGRES_USER=mashkif
POSTGRES_DB=mashkif
POSTGRES_PASSWORD=change-me

# Server (app container). Repeat the PostgreSQL user, password, and database
# name from above; the host name is the Compose service name db.
DATABASE_URL=postgres://mashkif:change-me@db:5432/mashkif

# Secret key of the server: at least 32 random bytes in base64. Generate one
# with: openssl rand -base64 32
# Admin sign-in secrets are derived from it, and the TOTP secret is encrypted
# with it: a new key signs the admin out and makes the enrolled TOTP unusable,
# so run cli.js reset-admin after changing it. Back it up together with .env.
# The server refuses to start with the placeholder.
MASHKIF_APP_KEY=change-me

# Origin the browser uses for the web app, without a path. Passkeys are bound
# to its host name. Production: https://mashkif.co.il. Local development:
# http://127.0.0.1:8180 (plain HTTP is accepted only for localhost and 127.0.0.1).
MASHKIF_PUBLIC_URL=https://mashkif.co.il

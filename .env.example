# Mashkif environment template. Copy to .env next to the Compose file and
# replace every placeholder. Never commit .env.
#
# Docker Compose reads .env twice: for ${...} interpolation in the Compose file
# (only the MASHKIF_* deployment values in the first block) and, through
# env_file, as the environment of the app and db containers.
# Keep comments on their own lines; values have no quotes and no inline comments.

# Deployment values used by Compose interpolation. Paths are absolute; ~ is not
# expanded. For development, MASHKIF_DATA_DIR must be on WSL ext4 (for example
# /home/<user>/mashkif-data), not under /mnt.
# MASHKIF_IMAGE_TAG and MASHKIF_TRAEFIK_NETWORK are used in production only.
MASHKIF_IMAGE_TAG=0.0.0
MASHKIF_DATA_DIR=/absolute/path/to/mashkif-data
MASHKIF_GEOIP_DIR=/absolute/path/to/geoip-directory
MASHKIF_TRAEFIK_NETWORK=traefik-network-name

# PostgreSQL (db container). Replace the placeholder password with a random
# one. Generate one with:
# openssl rand -hex 32
# Hex needs no escaping in DATABASE_URL. The db container refuses to start
# with an empty password or the placeholder, before PostgreSQL initializes.
POSTGRES_USER=mashkif
POSTGRES_DB=mashkif
POSTGRES_PASSWORD=change-me

# Server (app container). Repeat the PostgreSQL user, password, and database
# name from above; the host name is the Compose service name db. The server
# refuses to start with an empty password or the placeholder.
DATABASE_URL=postgres://mashkif:change-me@db:5432/mashkif

# Better Auth secret: at least 32 random characters. Generate one with:
# openssl rand -base64 32
# Better Auth signs sessions and encrypts the TOTP secret and backup codes with
# it, and Mashkif encrypts the stored SMTP password with it. A new secret signs
# the admin out and makes the enrolled TOTP, the backup codes, and the stored
# SMTP password unusable. Back it up together with .env. The server refuses to
# start with the placeholder.
BETTER_AUTH_SECRET=change-me

# Every other setting is managed in the admin panel (Settings). The variables
# below are optional: a variable that is set and not empty overrides the value
# from the panel, and the panel shows that field locked.

# Origin the browser uses for the web app, without a path. Production:
# https://mashkif.co.il. Local development: http://localhost:8180 (plain HTTP
# is accepted only for localhost and 127.0.0.1; browsers refuse passkeys on an
# IP address). Unset: Better Auth takes the origin from each request.
BETTER_AUTH_URL=https://mashkif.co.il

# Reverse proxies whose X-Forwarded-For header is believed: IP addresses or
# CIDR ranges, separated by commas. Mashkif's own resolver (agent API, admin
# audit) and Better Auth's client address handling (sign-in rate limits) are
# configured from this list but are separate. Empty: Mashkif takes the TCP
# peer as the client, so behind Traefik every agent would count as Traefik's
# address, and Better Auth applies its own documented behavior. Production:
# the subnet of the Docker network that only Traefik and the app share, for
# example 172.18.0.0/16. Never list a network that other containers or
# clients can reach directly, or they could forge their address.
MASHKIF_TRUSTED_PROXIES=

# Further optional overrides of panel settings: BETTER_AUTH_TRUSTED_ORIGINS
# (other trusted origins, comma-separated), MASHKIF_SESSION_HOURS (1 to 168,
# default 12), MASHKIF_SMTP_HOST, MASHKIF_SMTP_PORT (465, or a port that offers
# STARTTLS), MASHKIF_SMTP_USER, MASHKIF_SMTP_PASSWORD, MASHKIF_SMTP_FROM.

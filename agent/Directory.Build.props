<Project>
  <!-- Shared settings for every project under agent/. -->
  <PropertyGroup>
    <!-- Agent version. The MSI version and file name come from this value. -->
    <Version>0.1.0</Version>
    <Product>Mashkif</Product>
    <Company>Mashkif</Company>
    <Copyright>Copyright (c) 2026 Shlomi Porush</Copyright>
    <ArtifactsRoot>$(MSBuildThisFileDirectory)artifacts\</ArtifactsRoot>
  </PropertyGroup>

  <!--
    WiX Toolset v7 builds only after its Open Source Maintenance Fee EULA is
    accepted. The maintainer accepted it for this project on 2026-11-03; the
    condition is recorded in docs/project-foundation.md ("WiX version").
    AcceptEula is the property both WixToolset.Sdk (the .wixproj files) and
    the WixToolset.Dtf.WindowsInstaller package (the installer test projects)
    check, so it is set for every project here. It writes nothing to the
    user profile.
  -->
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en;he</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- NuGet: central package versions and committed lock files. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>

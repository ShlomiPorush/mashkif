<?xml version="1.0" encoding="utf-8"?>
<!--
  Mashkif for Windows: the EXE installer, a Burn bundle that installs the
  English MSI with the WiX Standard Bootstrapper Application (English UI).
  Apps and Features shows one entry, the bundle's; the MSI entry is hidden.

  Install:          double-click, or right-click and "Run as administrator"
  Silent install:   Mashkif-<version>-x64.exe /quiet /norestart /log <file>
  Another server (development only):
                    Mashkif-<version>-x64.exe /quiet /norestart /log <file> SERVER_URL=<url>
  Repair:           Mashkif-<version>-x64.exe /repair /quiet /norestart /log <file>
  Uninstall:        Mashkif-<version>-x64.exe /uninstall /quiet /norestart /log <file>
  Always pass /norestart with /quiet: without it a quiet run restarts the PC
  by itself when a restart is needed. The QuietUninstallString that Burn
  registers has no /norestart, so append it when you run that string.

  The finish page of a full-UI install, repair, or upgrade offers Launch,
  which starts the tray app, unless the EXE was started elevated or a restart
  is required (see LaunchTarget below). A quiet or passive run never starts it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <!-- The bundle upgrade code never changes; it is not the MSI's upgrade code. -->
  <Bundle Name="Mashkif for Windows"
          Manufacturer="Mashkif"
          Version="$(ProductVersion)"
          UpgradeCode="8B44898D-0D6E-4E7D-AA33-220084833485"
          AboutUrl="https://mashkif.co.il"
          DisableModify="yes">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://github.com/ShlomiPorush/mashkif/blob/main/agent/LICENSE"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <!--
      Development only: another server. Passed to the MSI only when set, so a
      repair or upgrade without it keeps the value the MSI remembered.
    -->
    <Variable Name="SERVER_URL" bal:Overridable="yes" />

    <!--
      The MSI's default INSTALLFOLDER, ProgramFiles64Folder\Mashkif. The bundle
      passes the MSI no property but SERVER_URL, never INSTALLFOLDER, so when
      the EXE installs the MSI, Windows Installer resolves INSTALLFOLDER from
      the Directory table to this default ("If the property is not defined,
      the destination directory is resolved to a subdirectory beneath the
      resolved destination directory for the Directory_Parent entry",
      https://learn.microsoft.com/windows/win32/msi/directory-table). An MSI
      that was installed on its own to another folder keeps that folder, so
      Launch would point at a missing file; the README does not support that
      mix (uninstall such an MSI before using the EXE). Not overridable.
    -->
    <Variable Name="InstallFolder" Type="formatted" Value="[ProgramFiles64Folder]Mashkif\" />

    <!--
      LaunchTarget makes the WixStdBA finish page show Launch after an install,
      repair, or upgrade; never after an uninstall or a failure, never in a
      quiet or passive run, and not when a restart is required and allowed,
      where the page shows Restart instead. WixStdBA starts it from the bootstrapper
      application process, which has the token the EXE was started with. It is
      set only when the bundle did not start elevated: after "Run as
      administrator" (or with UAC off) Launch would start the tray elevated,
      possibly as another account, so the button stays hidden and the tray
      starts at the next sign-in through the machine Run key.
      WixBundleElevated still holds the start state here: searches run at
      detect, before Burn elevates at apply.
    -->
    <SetVariable Id="LaunchTrayWhenNotElevated"
                 Variable="LaunchTarget"
                 Type="formatted"
                 Value="[InstallFolder]Tray\Mashkif.Tray.exe"
                 Condition="NOT WixBundleElevated" />

    <Chain>
      <!-- Hidden in Apps and Features (Visible defaults to no): only the bundle entry shows. -->
      <MsiPackage Id="Mashkif" SourceFile="$(MsiPath)">
        <MsiProperty Name="SERVER_URL" Value="[SERVER_URL]" Condition="SERVER_URL" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>

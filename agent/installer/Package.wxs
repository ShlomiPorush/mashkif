<?xml version="1.0" encoding="utf-8"?>
<!--
  Mashkif for Windows: per-machine MSI for manual, GPO, and Intune deployment.
  Silent install:   msiexec /i Mashkif-<version>-x64.msi /qn
  The service registers the PC by itself at its first start; nothing else is needed.
  Another server (development only):
                    msiexec /i Mashkif-<version>-x64.msi SERVER_URL=<url> /qn
  Silent uninstall: msiexec /x Mashkif-<version>-x64.msi /qn

  <svc> below is the service SID of NT SERVICE\Mashkif,
  S-1-5-80-955452773-2337780239-555098662-296726712-2311605372 (sc showsid Mashkif).
  OW is OWNER RIGHTS: objects the service creates are owned by LocalService,
  which other services share, so the owner gets read control only.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="!(loc.ProductName)"
           Manufacturer="!(loc.Manufacturer)"
           Version="$(ProductVersion)"
           UpgradeCode="D80A17FB-1D99-47D0-A228-8FC027BE1667"
           Language="!(loc.Language)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://mashkif.co.il" />

    <!--
      SERVER_URL: the server origin; absent means https://mashkif.co.il. A repair
      or upgrade without the property keeps the stored value ("remember property":
      AppSearch reads it into SAVED_SERVER_URL, and SERVER_URL is set from it only
      when the command line did not set it).
    -->
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="SAVED_SERVER_URL" Secure="yes">
      <RegistrySearch Id="SavedServerUrl" Root="HKLM" Key="SOFTWARE\Mashkif\Agent" Name="ServerUrl" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="SERVER_URL" Value="[SAVED_SERVER_URL]" After="AppSearch" Sequence="both" Condition="NOT SERVER_URL AND SAVED_SERVER_URL" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Mashkif">
        <Directory Id="ServiceFolder" Name="Service" />
        <Directory Id="TrayFolder" Name="Tray" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="DataFolder" Name="Mashkif">
        <Directory Id="ServiceLogFolder" Name="logs" />
        <Directory Id="StateFolder" Name="state" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="TrayComponents" />
    </Feature>

    <!--
      Close the tray app in every user session before its files are removed.
      Restart Manager closes it only in the session that runs msiexec, so a
      GPO or Intune uninstall running as SYSTEM would leave it running and
      schedule the file for deletion at the next reboot. This deferred action
      runs as LocalSystem; the tray keeps no state, so ending it is safe.
      Exit code 128 (no such process) is expected and ignored.
    -->
    <StandardDirectory Id="System64Folder" />
    <CustomAction Id="CloseTrayApps"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]taskkill.exe&quot; /F /IM Mashkif.Tray.exe"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CloseTrayApps" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <ComponentGroup Id="ServiceComponents">
      <Component Id="ServiceExecutable" Directory="ServiceFolder" Bitness="always64">
        <File Id="ServiceExe" Source="$(ServicePublishDir)Mashkif.Service.exe" KeyPath="yes" />
        <!-- Least privilege: the service runs as LocalService, not LocalSystem. -->
        <ServiceInstall Id="MashkifService"
                        Name="Mashkif"
                        DisplayName="Mashkif Agent"
                        Description="Reports internet connectivity to the Mashkif outage map."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="NT AUTHORITY\LocalService"
                        Vital="yes">
          <!-- The service SID NT SERVICE\Mashkif is in the service token, so ACLs can name it. -->
          <ServiceConfig ServiceSid="unrestricted" OnInstall="yes" OnReinstall="yes" />
        </ServiceInstall>
        <ServiceControl Id="MashkifServiceControl"
                        Name="Mashkif"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <!--
        %ProgramData%\Mashkif: SYSTEM and Administrators full control, Users
        read (to reach the logs), this folder only. Protected, so a folder a
        standard user created before installation loses the user's access.
      -->
      <Component Id="DataFolderAcl" Directory="DataFolder" Guid="111CC822-2EA1-4B40-B8BF-97877C66DDB6" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;;FA;;;SY)(A;;FA;;;BA)(A;;0x1200a9;;;BU)(A;;RC;;;OW)" />
        </CreateFolder>
      </Component>

      <!--
        %ProgramData%\Mashkif\logs: SYSTEM and Administrators full control,
        LocalService modify (the service writes here), Users read. Inheritance
        from %ProgramData% is blocked so standard users cannot alter the logs.
        Windows Installer removes the folder on uninstall only when it is empty,
        so existing logs stay for troubleshooting.
      -->
      <Component Id="ServiceLogFolderAcl" Directory="ServiceLogFolder" Guid="5B0C6E1A-3F44-4B8E-9C2D-1E7A4F9B6C30" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1301bf;;;LS)(A;OICI;0x1200a9;;;BU)(A;OICI;RC;;;OW)" />
        </CreateFolder>
      </Component>

      <!--
        %ProgramData%\Mashkif\state: the token and the install ID. SYSTEM,
        Administrators, and the service SID only; nobody else may read it.
        The state stays on uninstall, like the logs.
      -->
      <Component Id="StateFolderAcl" Directory="StateFolder" Guid="BB4E3E06-B026-4A01-8A01-9E53DB4BE296" Bitness="always64">
        <CreateFolder>
          <PermissionEx Sddl="D:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;FA;;;S-1-5-80-955452773-2337780239-555098662-296726712-2311605372)(A;OICI;RC;;;OW)" />
        </CreateFolder>
      </Component>

      <!--
        HKLM\SOFTWARE\Mashkif\Agent with Service (the parent of the volatile
        Boot key) for SYSTEM, Administrators, and the service SID only. The
        whole tree is removed on uninstall.
      -->
      <Component Id="AgentRegistryKeys" Directory="INSTALLFOLDER" Guid="5F0E1BEA-5953-440C-9E3B-CF848B17F450" Bitness="always64">
        <RegistryKey Root="HKLM" Key="SOFTWARE\Mashkif" ForceDeleteOnUninstall="yes">
          <RegistryKey Key="Agent">
            <RegistryValue Name="Version" Type="string" Value="$(ProductVersion)" KeyPath="yes" />
            <RegistryKey Key="Service" ForceCreateOnInstall="yes">
              <PermissionEx Sddl="D:PAI(A;CI;KA;;;SY)(A;CI;KA;;;BA)(A;CI;KA;;;S-1-5-80-955452773-2337780239-555098662-296726712-2311605372)(A;CI;RC;;;OW)" />
            </RegistryKey>
          </RegistryKey>
        </RegistryKey>
      </Component>

      <!-- SERVER_URL, written only when it is set (on the command line or remembered). -->
      <Component Id="ServerUrlValue" Directory="INSTALLFOLDER" Bitness="always64" Condition="SERVER_URL" Transitive="yes">
        <RegistryValue Root="HKLM" Key="SOFTWARE\Mashkif\Agent" Name="ServerUrl" Type="string" Value="[SERVER_URL]" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="TrayComponents" Directory="TrayFolder">
      <Component Id="TrayExecutable" Bitness="always64">
        <File Id="TrayExe" Source="$(TrayPublishDir)Mashkif.Tray.exe" KeyPath="yes" />
        <!-- Start the tray app at every user sign-in. -->
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="Mashkif"
                       Type="string"
                       Value="&quot;[#TrayExe]&quot;" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>

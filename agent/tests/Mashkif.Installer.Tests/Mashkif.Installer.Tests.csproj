<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Reads the tables of the MSI that the agent area built (agent/artifacts/msi).
    scripts/lib/verify-agent.sh builds the MSI before it runs the tests;
    without the MSI these tests fail, they never skip.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Mashkif.Installer.Tests</RootNamespace>
    <!-- Test names read as sentences with underscores. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>

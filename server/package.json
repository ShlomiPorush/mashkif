{
  "name": "@mashkif/server",
  "version": "0.0.0",
  "private": true,
  "description": "Mashkif server: agent API, readiness, and the built web app on one origin.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check": "biome ci --colors=off .",
    "format": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.12",
    "@hono/node-server": "^2.1.5",
    "better-auth": "1.7.12",
    "drizzle-orm": "^0.45.4",
    "h3-js": "4.5.0",
    "hono": "^4.13.16",
    "ipaddr.js": "2.5.0",
    "maxmind": "5.0.7",
    "nodemailer": "10.3.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@mashkif/contracts": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
